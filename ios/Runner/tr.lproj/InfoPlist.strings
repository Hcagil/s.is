/* Kişiler izin penceresi (iPhone bir kez sorar, sonra Ayarlar). */
"NSContactsUsageDescription" = "SIS, rehberinizi okur. Böylece sohbette bir kişi gönderebilirsiniz ve Kişi bul ekranında rehberinizdeki SIS kullanan kişileri görebilirsiniz. Yalnızca kodlanmış (hash) e-posta adresleri SIS'e iletilir. Bu adresler SIS üyeleriyle karşılaştırılır ve saklanmaz.";

/* Kamera izin penceresi (iPhone bir kez sorar, sonra Ayarlar). */
"NSCameraUsageDescription" = "Fotoğraf çekip sohbette göndermek için kameraya erişime izin verin. Fotoğraf yalnızca siz gönderdiğinizde yüklenir.";

/* Fotoğraf kitaplığı izin penceresi (iPhone bir kez sorar, sonra Ayarlar). */
"NSPhotoLibraryUsageDescription" = "Fotoğraf ve videolarınız doğrudan sohbette görünsün diye erişime izin verin. Siz göndermeden hiçbir şey yüklenmez. Yalnızca birkaçına izin verebilirsiniz.";

/* Konum izin penceresi (iPhone bir kez sorar, sonra Ayarlar). */
