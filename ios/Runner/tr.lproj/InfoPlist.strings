/* Kişiler izin penceresi (iPhone bir kez sorar, sonra Ayarlar). */
"NSContactsUsageDescription" = "SIS, sohbette bir kişi gönderebilmen ve Kişi bul sayfasını açtığında rehberindeki hangi kişilerin SIS kullandığını görebilmen için rehberini okur. Yalnızca kodlanmış (hash) e-posta adresleri SIS'e gönderilir; SIS üyeleriyle karşılaştırılır ve saklanmaz.";

/* Kamera izin penceresi (iPhone bir kez sorar, sonra Ayarlar). */
"NSCameraUsageDescription" = "Fotoğraf çekip sohbette gönderebilmen için kameraya erişime izin ver. Fotoğraf yalnızca sen gönderdiğinde yüklenir.";

/* Fotoğraf kitaplığı izin penceresi (iPhone bir kez sorar, sonra Ayarlar). */
"NSPhotoLibraryUsageDescription" = "Fotoğrafların ve videoların sohbette burada yüklensin diye erişime izin ver. Sen gönderene kadar hiçbir şey gönderilmez. Yalnızca birkaçına izin verebilirsin.";

/* Konum izin penceresi (iPhone bir kez sorar, sonra Ayarlar). */
"NSLocationWhenInUseUsageDescription" = "Bulunduğun yeri sohbette paylaşabilmen için erişime izin ver. Konumun yalnızca sen göndermeyi seçtiğinde okunur.";

"NSLocationAlwaysAndWhenInUseUsageDescription" = "Bulunduğun yeri sohbette paylaşabilmen için erişime izin ver. Konumun yalnızca sen göndermeyi seçtiğinde okunur.";

/* Mikrofon izin penceresi (iPhone bir kez sorar, sonra Ayarlar). */
"NSMicrophoneUsageDescription" = "Sesli mesaj kaydedebilmen ve yazıyı sesle yazdırabilmen için mikrofona izin ver. Ses yalnızca sesli mesajı gönderdiğinde gönderilir.";

/* Konuşma tanıma izin penceresi (iPhone bir kez sorar, sonra Ayarlar). */
"NSSpeechRecognitionUsageDescription" = "Sesini mesaj kutusunda yazıya çevirebilmek için konuşma tanımaya izin ver. Telefonunda çalışır.";
