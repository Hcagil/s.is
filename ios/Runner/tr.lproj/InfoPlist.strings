/* Kişiler izin penceresi (iPhone bir kez sorar, sonra Ayarlar). */
"NSContactsUsageDescription" = "SIS, sohbette bir kişi gönderebilmen ve Kişi bul sayfasını açtığında rehberindeki hangi kişilerin SIS kullandığını görebilmen için rehberini okur. Yalnızca kodlanmış (hash) e-posta adresleri SIS'e gönderilir; SIS üyeleriyle karşılaştırılır ve saklanmaz.";

/* Kamera izin penceresi (iPhone bir kez sorar, sonra Ayarlar). */
"NSCameraUsageDescription" = "Fotoğraf çekip sohbette gönderebilmen için kameraya erişime izin ver. Fotoğraf yalnızca sen gönderdiğinde yüklenir.";

/* Fotoğraf kitaplığı izin penceresi (iPhone bir kez sorar, sonra Ayarlar). */
"NSPhotoLibraryUsageDescription" = "Fotoğraflarınız ve videolarınız sohbette burada yüklensin diye erişime izin verin. Siz gönderene kadar hiçbir şey gönderilmez. Yalnızca birkaçına izin verebilirsiniz.";

/* Konum izin penceresi (iPhone bir kez sorar, sonra Ayarlar). */
"NSLocationWhenInUseUsageDescription" = "Bulunduğunuz yeri sohbette paylaşabilmeniz için erişime izin verin. Konumunuz yalnızca siz göndermeyi seçtiğinizde okunur.";

"NSLocationAlwaysAndWhenInUseUsageDescription" = "Bulunduğunuz yeri sohbette paylaşabilmeniz için erişime izin verin. Konumunuz yalnızca siz göndermeyi seçtiğinizde okunur.";

/* Mikrofon izin penceresi (iPhone bir kez sorar, sonra Ayarlar). */
"NSMicrophoneUsageDescription" = "Sesli mesaj kaydedebilmeniz ve yazıyı sesle yazdırabilmeniz için mikrofona izin verin. Ses yalnızca sesli mesajı gönderdiğinizde gönderilir.";

/* Konuşma tanıma izin penceresi (iPhone bir kez sorar, sonra Ayarlar). */
"NSSpeechRecognitionUsageDescription" = "Sesinizi mesaj kutusunda yazıya çevirebilmek için konuşma tanımaya izin verin. Telefonunuzda çalışır.";
