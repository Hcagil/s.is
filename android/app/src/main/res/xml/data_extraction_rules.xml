<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing of the app's data leaves the device.
     android:allowBackup="false" in the manifest stops cloud backup, but for
     an app targeting Android 12+ it does NOT stop device-to-device transfer
     on every manufacturer (developer.android.com/guide/topics/data/autobackup),
     so these rules must stand on their own. Each rule names a path: the docs
     require one, and "." is the whole domain. Android 11 and lower read
     backup_rules.xml instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
