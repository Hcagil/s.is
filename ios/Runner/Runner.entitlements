<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications. "development" here; Xcode replaces it with the
	     provisioning profile's value (production) when it signs for TestFlight
	     and the App Store. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Share into SIS: the App Group the Share Extension (com.esd.sis.share) hands shared files to the app through. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.esd.sis</string>
	</array>
	<!-- Keychain groups. The default group (TEAMID.com.esd.sis) MUST stay first: it is where every key was kept until now and where other plugins keep theirs. The crypto group holds the store key and the Olm pickle key and is shared with the notification extension only (ios/NotificationService/NotificationService.entitlements). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.esd.sis</string>
		<string>$(AppIdentifierPrefix)com.esd.sis.crypto</string>
	</array>
	<!-- Sign in with Apple (the iPhone button). The profile must carry the same entitlement: tool/asc_signing.py (ensure with the signin flag). -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
