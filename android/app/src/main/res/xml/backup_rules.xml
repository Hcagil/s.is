<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower: nothing of the app's data leaves the device.
     android:allowBackup="false" already disables every form of backup on
     these versions; this is the same exclusion stated explicitly, so the
     manifest's dataExtractionRules (Android 12+) has a counterpart for the
     versions it does not cover. -->
<full-backup-content>
    <exclude domain="root" path="."/>
    <exclude domain="file" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="external" path="."/>
</full-backup-content>
