<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications. "development" here; Xcode replaces it with the
	     provisioning profile's value (production) when it signs for TestFlight
	     and the App Store. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
