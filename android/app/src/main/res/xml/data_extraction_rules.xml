<?xml version="1.0" encoding="utf-8"?>
<!-- Belt-and-braces alongside android:allowBackup="false" in the manifest,
     which already disables both cloud backup and device-to-device transfer
     on every Android version: this is only consulted if allowBackup ever
     becomes true, and it excludes everything either way. See
     docs/SECURITY.md. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref"/>
        <exclude domain="database"/>
        <exclude domain="file"/>
        <exclude domain="root"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref"/>
        <exclude domain="database"/>
        <exclude domain="file"/>
        <exclude domain="root"/>
    </device-transfer>
</data-extraction-rules>
